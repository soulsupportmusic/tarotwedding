* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --fg: #2a2a2a;
  --muted: #6b6b6b;
  --bg: #f5f3f0;
  --bg2: #ede5df;
  --ink: #2a2a2a;
  --accent: #8b6b47;
  --card: #fafaf8;
  --gold: #c4956b;
}

body {
  font-family: 'Lora', 'Cormorant Garamond', serif;
  background: var(--bg);
  color: var(--fg);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 700;
  letter-spacing: 0.2px;
  line-height: 1.15;
}

html {
  scroll-behavior: smooth;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in {
  animation: fadeInUp 0.8s ease-out forwards;
}

nav {
  position: fixed;
  top: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  z-index: 1000;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

nav.scrolled {
  box-shadow: 0 2px 30px rgba(0, 0, 0, 0.1);
}

.nav-content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
  height: 70px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0.8px;
  color: var(--ink);
  font-family: 'Cormorant Garamond', serif;
  transition: transform 0.3s ease;
}

.logo:hover {
  transform: scale(1.05);
}

.nav-links {
  display: flex;
  gap: 48px;
  list-style: none;
}

.nav-links a {
  color: var(--ink);
  text-decoration: none;
  font-size: 16px;
  font-weight: 500;
  opacity: 0.85;
  transition: all 0.3s;
  position: relative;
}

.nav-links a:hover {
  opacity: 1;
}

.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -6px;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--accent);
  transition: width 0.3s ease;
}

.nav-links a:hover::after {
  width: 100%;
}

.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 88px 32px 180px;
  background: linear-gradient(135deg, var(--bg) 0%, var(--bg2) 100%);
  position: relative;
  overflow: hidden;
  margin-top: 70px;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 40%, rgba(230, 180, 140, 0.15) 0%, transparent 60%),
    radial-gradient(circle at 70% 70%, rgba(180, 160, 130, 0.12) 0%, transparent 60%);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 1100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40px;
}

.hero-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48px;
}

.hero-cards {
  position: relative;
  height: 160px;
  transform: translateY(-36px);
}

.hero-card {
  width: 110px;
  height: 165px;
  border-radius: 10px;
  position: absolute;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  transform-origin: bottom center;
  background-size: cover;
  background-position: center;
  left: 50%;
  transform: translateX(-50%);
  transition: transform 0.3s ease;
}

.hero-card:hover {
  transform: translateX(-50%) translateY(-5px);
}

.hero-card:nth-child(1) {
  transform: translateX(-50%) rotate(-18deg) translateX(-70px);
  background-image: url('{{ 'hero-card.jpg' | asset_url }}');
  z-index: 3;
}

.hero-card:nth-child(2) {
  transform: translateX(-50%) rotate(0deg);
  background-image: url('{{ 'hero-card-2.jpg' | asset_url }}');
  z-index: 2;
}

.hero-card:nth-child(3) {
  transform: translateX(-50%) rotate(18deg) translateX(70px);
  background-image: url('{{ 'hero-card-3.jpg' | asset_url }}');
  z-index: 1;
}

.hero-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  width: 100%;
}

h1 {
  font-size: clamp(56px, 8.5vw, 112px);
  font-weight: 700;
  letter-spacing: -2px;
  line-height: 1.05;
  color: var(--ink);
  opacity: 0;
  animation: fadeInUp 0.8s ease-out 0.4s forwards;
  margin: -4px 0 0;
}

.hero-subtitle {
  font-size: clamp(22px, 2.4vw, 30px);
  font-weight: 400;
  color: var(--muted);
  letter-spacing: -0.2px;
  line-height: 1.5;
  opacity: 0;
  animation: fadeInUp 0.8s ease-out 0.6s forwards;
  width: 100%;
  margin: 0 auto;
  text-align: center;
}

.hero-subtitle .line {
  white-space: nowrap;
  display: block;
}

.subtitle-lines {
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 100%;
  align-items: center;
  justify-content: center;
}

.cta-buttons {
  display: flex;
  gap: 24px;
  justify-content: center;
  flex-wrap: wrap;
  opacity: 0;
  animation: fadeInUp 0.8s ease-out 0.8s forwards;
  margin-bottom: 96px;
}

.cta-button {
  display: inline-block;
  background: var(--ink);
  color: #fff;
  padding: 18px 46px;
  border-radius: 10px;
  text-decoration: none;
  font-size: 17px;
  font-weight: 600;
  transition: all 0.3s;
  box-shadow: 0 6px 22px rgba(0, 0, 0, 0.18);
  font-family: 'Lora', serif;
  border: 2px solid var(--ink);
  letter-spacing: 0.3px;
}

.cta-button:hover {
  background: #1a1a1a;
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.3);
  transform: translateY(-3px);
}

.cta-button.secondary {
  background: transparent;
  color: var(--ink);
  box-shadow: none;
}

.cta-button.secondary:hover {
  background: var(--ink);
  color: #fff;
}

.problem-solution {
  padding: 120px 32px;
  background: #fff;
}

.ps-container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: stretch;
}

.ps-block {
  padding: 48px;
  border-radius: 20px;
  transition: all 0.4s ease;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  min-height: 380px;
  border: 2px solid transparent;
}

.ps-block.problem {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
  border: 2px solid #ffcccb;
}

.ps-block.solution {
  background: linear-gradient(135deg, #f0f9f4 0%, #e6f4ec 100%);
  border: 2px solid #b8e6c9;
}

.ps-block:hover {
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  transform: translateY(-6px);
}

.ps-icon {
  font-size: 56px;
  margin-bottom: 24px;
}

.ps-title {
  font-size: 28px;
  margin-bottom: 20px;
  color: var(--ink);
  line-height: 1.3;
}

.ps-text {
  font-size: 18px;
  line-height: 1.7;
  color: var(--muted);
  flex-grow: 1;
}

.how-it-works {
  padding: 120px 32px;
  background: linear-gradient(135deg, var(--bg) 0%, var(--bg2) 100%);
}

.hiw-container {
  max-width: 1200px;
  margin: 0 auto;
}

.section-header {
  text-align: center;
  margin-bottom: 80px;
}

.section-title {
  font-size: clamp(42px, 6vw, 56px);
  margin-bottom: 24px;
  letter-spacing: -1.5px;
  color: var(--ink);
}

.section-subtitle {
  font-size: 20px;
  color: var(--muted);
  max-width: 780px;
  margin: 0 auto;
  line-height: 1.6;
}

.steps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 40px;
}

.step {
  text-align: center;
  padding: 40px 32px;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20px;
  transition: all 0.4s ease;
  border: 1px solid rgba(0, 0, 0, 0.06);
  min-height: 320px;
  display: flex;
  flex-direction: column;
  backdrop-filter: blur(10px);
}

.step:hover {
  background: #fff;
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
  transform: translateY(-8px);
}

.step-number {
  display: inline-block;
  width: 64px;
  height: 64px;
  line-height: 64px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 24px;
}

.step-title {
  font-size: 24px;
  margin-bottom: 16px;
  color: var(--ink);
  line-height: 1.3;
}

.step-text {
  font-size: 17px;
  line-height: 1.6;
  color: var(--muted);
  flex-grow: 1;
}

.cards-section {
  background: #fff;
  padding: 160px 32px 140px;
  --card-width: 240px;
}

.cards-container {
  max-width: 1200px;
  margin: 0 auto;
}

.cards-row {
  display: flex;
  gap: 64px;
  align-items: flex-start;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 16px;
}

.cards-row .card-category {
  flex: 0 0 auto;
}

.cards-row .event-cards-wrapper {
  max-width: none;
}

.cards-row .cards-grid.three-inline {
  max-width: none;
}

.card-category {
  margin-top: 64px;
  margin-bottom: 96px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-heading {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 36px;
  text-align: center;
  align-items: center;
}

.card-heading-title {
  font-size: 34px;
  line-height: 1.2;
  letter-spacing: -0.8px;
  color: var(--ink);
}

.event-cards-wrapper {
  display: flex;
  justify-content: center;
  gap: 56px;
  flex-wrap: wrap;
}

.event-card-wrapper {
  width: 100%;
  max-width: var(--card-width, 160px);
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 40px;
  justify-items: center;
  max-width: 900px;
  margin: 0 auto;
}

.cards-grid.three-inline {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  justify-items: center;
  margin: 0;
}

.card-wrapper {
  position: relative;
  width: 100%;
  max-width: var(--card-width, 160px);
  aspect-ratio: 7 / 12;
  cursor: pointer;
  perspective: 1200px;
  transition: transform 0.4s ease;
}

.card-wrapper:hover {
  transform: translateY(-12px);
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.9s ease-in-out;
  transform-style: preserve-3d;
}

.card-wrapper:hover .card-inner,
.card-wrapper:focus-within .card-inner,
.card-wrapper:active .card-inner {
  transform: rotateY(180deg);
}

.card-front,
.card-back {
  position: absolute;
  inset: 0;
  border-radius: 14px;
  border: none;
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
  background-size: cover;
  background-position: center;
  backface-visibility: hidden;
}

.card-front {
  background-image: url('{{ 'card-front.jpg' | asset_url }}');
}

.card-front.kategorie {
  background-image: url('{{ 'category-front.jpg' | asset_url }}');
}

.card-back.kategorie {
  background-image: url('{{ 'category-back.jpg' | asset_url }}');
}

.card-back {
  transform: rotateY(180deg);
}

.card-back.c1 {
  background-image: url('{{ 'c1.jpg' | asset_url }}');
}

.card-back.c2 {
  background-image: url('{{ 'c2.jpg' | asset_url }}');
}

.card-back.c3 {
  background-image: url('{{ 'c3.jpg' | asset_url }}');
}

.testimonials {
  background: linear-gradient(135deg, var(--bg) 0%, var(--bg2) 100%);
  padding: 120px 32px;
}

.testimonials-container {
  max-width: 1200px;
  margin: 0 auto;
}

.testimonial-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 40px;
  margin-top: 80px;
}

.testimonial {
  background: #fff;
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 20px;
  padding: 48px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  transition: all 0.4s ease;
  min-height: 320px;
  display: flex;
  flex-direction: column;
}

.testimonial:hover {
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  transform: translateY(-6px);
}

.testimonial p {
  font-size: 20px;
  line-height: 1.6;
  color: var(--fg);
  margin-bottom: 32px;
  font-style: italic;
  flex-grow: 1;
}

.t-person {
  display: flex;
  align-items: center;
  gap: 20px;
}

.t-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: #ddd;
  background-size: cover;
  background-position: center;
  border: 3px solid var(--accent);
}

.t-meta {
  display: flex;
  flex-direction: column;
  font-size: 15px;
  color: var(--muted);
}

.t-name {
  font-weight: 700;
  color: var(--ink);
  font-size: 18px;
}

.about {
  background: #fff;
  padding: 120px 32px;
}

.about-container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.about-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40px 0;
}

.about-title {
  font-size: 42px;
  margin-bottom: 32px;
  color: var(--ink);
  letter-spacing: -1px;
  line-height: 1.2;
}

.about-text {
  font-size: 19px;
  line-height: 1.7;
  color: var(--muted);
}

.about-image {
  background: #fff;
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 20px;
  padding: 48px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  transition: all 0.4s ease;
  min-height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: var(--muted);
  background-image: url('{{ 'founders-placeholder.jpg' | asset_url }}');
  background-size: cover;
  background-position: center;
}

.about-image:hover {
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  transform: translateY(-6px);
}

.pricing-cta {
  background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 100%);
  padding: 120px 32px;
  text-align: center;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.pricing-cta::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

.pricing-container {
  max-width: 880px;
  margin: 0 auto;
}

.pricing-title {
  font-size: clamp(42px, 6vw, 56px);
  margin-bottom: 28px;
  letter-spacing: -1.5px;
  color: #fff;
}

.pricing-subtitle {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 60px;
  line-height: 1.6;
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
}

.price-box {
  background: rgba(255, 255, 255, 0.08);
  border: 2px solid rgba(196, 149, 107, 0.4);
  border-radius: 24px;
  padding: 60px 48px;
  margin-bottom: 48px;
  backdrop-filter: blur(20px);
}

.price {
  font-size: 72px;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: 20px;
  font-family: 'Cormorant Garamond', serif;
}

.price-detail {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 40px;
}

.features {
  text-align: left;
  max-width: 480px;
  margin: 0 auto 48px;
}

.feature {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
  font-size: 18px;
  color: rgba(255, 255, 255, 0.9);
}

.feature::before {
  content: '✓';
  color: var(--gold);
  font-weight: 700;
  font-size: 22px;
}

.cta-button.primary-inverse {
  background: #fff;
  color: var(--ink);
  border: 2px solid #fff;
  padding: 20px 52px;
  font-size: 18px;
}

.cta-button.primary-inverse:hover {
  background: var(--gold);
  border-color: var(--gold);
  color: #fff;
}

.pricing-faq {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 24px;
}

footer {
  background: #1a1a1a;
  color: #a0a0a0;
  padding: 60px 32px 30px;
}

.footer-content {
  max-width: 1200px;
  margin: 0 auto;
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 48px;
  margin-bottom: 40px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-links a {
  color: #a0a0a0;
  text-decoration: none;
  font-size: 15px;
  transition: color 0.3s;
}

.footer-links a:hover {
  color: #f5f5f5;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  color: #707070;
  flex-wrap: wrap;
  gap: 24px;
}

.card-category .event-cards-wrapper {
  max-width: var(--card-width, 160px);
  margin: 0 auto;
}

@media (min-width: 1024px) {
  .cards-row {
    display: grid;
    grid-template-columns: minmax(220px, 280px) 1fr;
    align-items: start;
    gap: 80px;
  }

  .card-category {
    align-items: flex-start;
  }

  .card-category .event-cards-wrapper {
    margin: 0;
    justify-content: flex-start;
  }

  .cards-grid {
    max-width: none;
    justify-items: flex-start;
  }

  .cards-grid.three-inline {
    width: 100%;
    gap: 32px;
  }

  .cards-grid.three-inline .card-wrapper {
    max-width: var(--card-width, 240px);
  }

  .card-heading {
    text-align: left;
    align-items: flex-start;
  }
}

@media (max-width: 900px) {
  .ps-container {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .nav-links {
    display: none;
  }

  .nav-content {
    height: 64px;
    padding: 0 20px;
  }

  .hero {
    min-height: auto;
    padding: 120px 24px 80px;
    margin-top: 64px;
  }

  .hero-content {
    gap: 36px;
  }

  .hero-header {
    gap: 56px;
  }

  h1 {
    font-size: clamp(42px, 9vw, 60px);
    letter-spacing: -1px;
  }

  .hero-subtitle {
    font-size: 20px;
    line-height: 1.45;
  }

  .hero-cards {
    height: 120px;
    transform: translateY(-16px);
  }

  .hero-card {
    width: 84px;
    height: 124px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
  }

  .about-container {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .about-content {
    padding: 0;
    text-align: center;
  }

  .footer-links {
    flex-wrap: wrap;
    gap: 24px;
  }

  .pricing-cta {
    padding: 100px 24px;
  }

  .section-header {
    margin-bottom: 64px;
  }
}

@media (max-width: 768px) {
  body {
    font-size: 16px;
  }

  .hero {
    padding: 110px 20px 64px;
  }

  .hero-cards {
    height: 110px;
    transform: translateY(0);
  }

  .hero-card {
    width: 76px;
    height: 112px;
  }

  .hero-card:nth-child(1) {
    transform: translateX(-50%) rotate(-12deg) translateX(-40px);
  }

  .hero-card:nth-child(3) {
    transform: translateX(-50%) rotate(12deg) translateX(40px);
  }

  .cta-buttons {
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .cta-button {
    width: 100%;
    max-width: 260px;
    padding: 14px 28px;
    font-size: 16px;
  }

  .cards-section {
    padding: 120px 20px 96px;
    --card-gap: 18px;
  }

  .cards-row {
    flex-direction: column;
    gap: 32px;
    align-items:center;
  }

  .card-category {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .card-heading {
    text-align: center;
    align-items: center;
  }

  .card-heading-title {
    font-size: 30px;
  }

  .card-category .event-cards-wrapper {
    max-width: none;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .event-card-wrapper {
    width: calc((100% - 2 * var(--card-gap, 18px)) / 3);
    max-width: 220px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--card-gap);
    width: 100%;
  }

  .cards-grid.three-inline {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cards-grid.three-inline .card-wrapper {
    width: 100%;
  }

  .card-wrapper {
    width: 100%;
    max-width: none;
  }

  .section-title {
    font-size: 32px;
  }

  .section-subtitle {
    font-size: 18px;
  }

  .testimonial-grid {
    grid-template-columns: 1fr;
  }

  .price {
    font-size: 52px;
  }

  .footer-bottom {
    flex-direction: column;
    text-align: center;
    gap: 16px;
  }
}

@media (max-width: 560px) {
  .nav-content {
    padding: 0 16px;
  }

  .logo {
    font-size: 18px;
  }

  .hero {
    padding-top: 108px;
    padding-bottom: 56px;
  }

  h1 {
    font-size: clamp(34px, 9vw, 40px);
  }

  .hero-subtitle {
    font-size: 18px;
    line-height: 1.4;
  }

  .subtitle-lines {
    gap: 6px;
  }

  .hero-cards {
    height: 96px;
    transform: translateY(0);
  }

  .hero-card {
    width: 68px;
    height: 100px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
  }

  .cards-section {
    padding: 96px 16px 80px;
    --card-gap: 14px;
  }

  .card-heading-title {
    font-size: 26px;
  }

  .event-card-wrapper {
    width: calc((100% - 2 * var(--card-gap, 14px)) / 3);
    max-width: 180px;
  }

  .cards-grid {
    gap: var(--card-gap);
  }

  .cards-grid.three-inline {
    gap: var(--card-gap);
  }

  .cards-grid.three-inline .card-wrapper {
    width: 100%;
  }

  .card-category {
    margin-top: 32px;
    margin-bottom: 48px;
  }

  .section-header {
    margin-bottom: 52px;
  }

  .pricing-cta {
    padding: 80px 20px;
  }

  .price-box {
    padding: 48px 28px;
  }
}

@media (max-width: 600px) {
  .hero-subtitle .line {
    white-space: normal;
  }
}

@media (min-width: 1400px) {
  .hero-content {
    max-width: 1280px;
  }

  h1 {
    font-size: clamp(64px, 8vw, 128px);
  }

  .hero-subtitle {
    font-size: clamp(24px, 2.2vw, 36px);
    max-width: 1040px;
  }

  .hero-cards {
    height: 200px;
  }

  .hero-card {
    width: 140px;
    height: 210px;
  }
}
