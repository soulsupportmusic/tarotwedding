# --- Allgemein ---------------------------------------------------------------
# Öffentliche Adresse der Website (ohne Slash am Ende)
SITE_URL=https://hochzeitstarot.de

# --- Stripe (Zahlung) --------------------------------------------------------
# Dashboard → Entwickler → API-Schlüssel (für Tests: sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard → Entwickler → Webhooks → Endpunkt https://<SITE_URL>/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Preis pro Deck in Cent (2900 = 29,00 €)
PRICE_CENTS=2900
# Lieferländer, kommagetrennt (ISO-Codes)
SHIP_COUNTRIES=DE
# Maximale Stückzahl pro Bestellung
MAX_QUANTITY=5

# --- Prodigi (Druck & Versand) ----------------------------------------------
# Dashboard → Settings → API Key. Mit sandbox wird nichts gedruckt oder berechnet.
PRODIGI_API_KEY=xxx
PRODIGI_ENV=sandbox
# SKU des Kartendecks aus dem Prodigi-Katalog (Tarot/Oracle Deck)
PRODIGI_SKU=
# Druckdaten als JSON-Liste: [{"printArea":"default","url":"https://.../deck.pdf"}]
PRODIGI_ASSETS=[]
# Budget | Standard | StandardPlus | Express | Overnight
PRODIGI_SHIPPING_METHOD=Standard
# Beliebiges langes Zufallsgeheimnis – schützt den Status-Webhook von Prodigi
PRODIGI_CALLBACK_TOKEN=bitte-zufaelligen-langen-wert-eintragen

# --- E-Mails (Resend) ---------------------------------------------------------
# resend.com → API Keys. Ohne Schlüssel werden Mails nur ins Log geschrieben.
RESEND_API_KEY=re_xxx
# Absender – Domain muss bei Resend verifiziert sein
MAIL_FROM=Das Hochzeitstarot <bestellung@hochzeitstarot.de>
# Hier landen Benachrichtigungen über neue Bestellungen und Fehler
SHOP_OWNER_EMAIL=soulmusic.bielefeld@gmail.com
